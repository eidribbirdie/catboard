#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off { hold-time-ms = <2000>; };

/ {
    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    behaviors {
    };

    combos {
        compatible = "zmk,combos";

        softoff {
            bindings = <&soft_off>;
            key-positions = <14 28 40>;
        };
    };

    macros {
        SHIFT_MCLK: SHIFT_MCLK {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&kp CAPS>,
                <&macro_press>,
                <&kp LSHFT>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LEFT_SHIFT &mkp MB3>;

            label = "SHIFT_MCLK";
        };

        cap_shft: cap_shft {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none>;
            label = "CAP_SHFT";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Colemak {
            bindings = <
&tog 1      &kp NUMBER_1  &kp N2  &kp N3  &kp N4     &kp N5       &kp UP_ARROW     &kp N6     &kp N7   &kp N8     &kp N9   &kp N0       &kp MINUS
&kp DELETE  &kp Q         &kp W   &kp F   &kp P      &kp G        &kp DOWN_ARROW   &kp J      &kp L    &kp U      &kp Y    &kp SEMI     &kp BACKSPACE
&kp CAPS    &kp A         &kp R   &kp S   &kp T      &kp D        &kp LEFT_ARROW   &kp H      &kp N    &kp E      &kp I    &kp O        &kp APOS
&kp LSHFT   &kp Z         &kp X   &kp C   &kp V      &kp B        &kp RIGHT_ARROW  &kp K      &kp M    &kp COMMA  &kp DOT  &kp FSLH     &kp RIGHT_SHIFT
&kp C_MUTE  &kp LCTRL     &tog 3  &none   &kp SPACE  &kp LG(L)    &kp ENTER        &kp ENTER  &kp TAB  &mo 2      &kp INS  &kp RA(TAB)
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
            display-name = "catboard";
        };

        Number {
            bindings = <
&trans                            &none            &mkp LCLK         &mkp MCLK          &mkp RCLK        &none              &mmv MOVE_UP     &kp GRAVE  &kp TILDE  &none   &kp SLASH  &none      &kp INS
&none                             &none            &none             &none              &none            &none              &mmv MOVE_DOWN   &kp N7     &kp N8     &kp N9  &kp ASTRK  &none      &none
&none                             &rgb_ug RGB_SPI  &rgb_ug RGB_SPD   &none              &none            &none              &mmv MOVE_LEFT   &kp N4     &kp N5     &kp N6  &kp MINUS  &none      &none
&rgb_ug RGB_COLOR_HSB(222,93,28)  &rgb_ug RGB_EFF  &rgb_ug RGB_EFR   &none              &rgb_ug RGB_BRI  &rgb_ug RGB_BRD    &mmv MOVE_RIGHT  &kp N1     &kp N2     &kp N3  &kp PLUS   &none      &rgb_ug RGB_TOG
&kp C_MUTE                        &none            &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &trans           &none              &mkp LCLK        &trans     &trans     &kp N0  &kp DOT    &kp EQUAL
            >;

            display-name = "Number";
            sensor-bindings = <&scroll_encoder>;
        };

        BT {
            bindings = <
&none  &bt BT_SEL 0  &bt BT_SEL 1    &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &mmv MOVE_UP     &none        &none  &none  &none       &none      &none
&none  &bt BT_CLR    &bt BT_CLR_ALL  &none         &none         &none           &mmv MOVE_DOWN   &none        &none  &none  &none       &none      &none
&none  &none         &sys_reset      &none         &none         &none           &mmv MOVE_LEFT   &none        &none  &none  &sys_reset  &soft_off  &none
&none  &none         &none           &none         &none         &bootloader     &mmv MOVE_RIGHT  &bootloader  &none  &none  &none       &none      &none
&none  &none         &none           &none         &none         &trans          &mkp LCLK        &none        &none  &none  &none       &none
            >;

            display-name = "reset";
            sensor-bindings = <&scroll_encoder>;
        };

        Steno {
            bindings = <
&tog 0  &none  &none     &none     &none     &none       &none  &none         &none     &none     &none     &none     &none
&none   &none  &kp HASH  &kp HASH  &kp HASH  &kp HASH    &none  &kp HASH      &kp HASH  &kp HASH  &kp HASH  &kp HASH  &kp HASH
&none   &none  &kp S     &kp T     &kp P     &kp H       &none  &kp ASTRK     &kp F     &kp P     &kp L     &kp T     &kp D
&none   &none  &kp S     &kp K     &kp W     &kp R       &none  &kp ASTERISK  &kp R     &kp B     &kp G     &kp S     &kp Z
&none   &none  &none     &none     &kp A     &kp O       &none  &kp E         &kp U     &none     &none     &none
            >;

            display-name = "Steno";
            sensor-bindings = <&inc_dec_kp PAGE_UP PG_DN>;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
            >;

            display-name = "layer4";
            sensor-bindings = <&scroll_encoder>;
        };
    };
};
